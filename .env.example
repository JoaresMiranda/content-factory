# Public values used by the browser and server-side Supabase clients
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional server-only service role key. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only OpenAI Responses API key for research; never use NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Server-only ElevenLabs API key for voice selection and text-to-speech.
ELEVENLABS_API_KEY=

# Random secret used by the Vercel scheduled research endpoint.
CRON_SECRET=

# OAuth de servidor: callbacks registrados exatamente iguais no Google/TikTok.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/oauth/tiktok/callback

# Gere valores aleatórios diferentes: openssl rand -base64 32 e openssl rand -hex 32.
OAUTH_STATE_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=
