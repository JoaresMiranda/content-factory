# Public values used by the browser and server-side Supabase clients
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional server-only service role key. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only OpenAI Responses API key for research; never use NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Random secret used by the Vercel scheduled research endpoint.
CRON_SECRET=
